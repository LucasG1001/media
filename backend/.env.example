DATABASE_URL=postgresql://user:password@127.0.0.1:5432/media_tracker
PORT=3333
TMDB_API_KEY=your_tmdb_api_key_here
# Token pessoal da Hardcover (hardcover.app/account/api). Obrigatório em TODA consulta,
# inclusive na busca do catálogo. Expira em 1 ano, com reset em 1º de janeiro.
HARDCOVER_API_TOKEN=your_hardcover_bearer_token_here
YOUTUBE_API_KEY=your_youtube_api_key_here


IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

NOTIFY_API_URL=
NOTIFY_API_KEY=

# Onde os bytes das capas ficam em disco (o metadado vai na tabela image_cache).
# Em produção o compose aponta para /data/images, que é um volume.
IMAGE_CACHE_DIR=.cache/images
# Sufixos de host extras aceitos por /api/img, separados por vírgula. A allowlist
# padrão cobre AniList/TMDB/IGDB/Hardcover/YouTube (ver lib/imageStore.ts).
IMAGE_EXTRA_HOSTS=
